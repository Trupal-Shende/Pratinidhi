# GEMINI_API_KEY: Required for Gemini AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI or local .env.
GEMINI_API_KEY=""

# GROQ_API_KEY: Required for Whisper speech-to-text audio transcription.
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DIGILOCKER ENDPOINT: Use the production or sandbox API URL
DIGILOCKER_API_ENDPOINT="https://api.digitallocker.gov.in"

# DIGILOCKER CREDENTIALS: Add your private keys here
DIGILOCKER_CLIENT_ID="YOUR_DIGILOCKER_CLIENT_ID"
DIGILOCKER_CLIENT_SECRET="YOUR_DIGILOCKER_CLIENT_SECRET"
